---
interface Props {
  topic?: string;
}
const { topic = "Opinion" } = Astro.props;
const paths: Record<string, string> = {
  Politics: "M3 9 12 4l9 5H3Zm2 3v7m5-7v7m4-7v7m5-7v7M3 22h18",
  Technology:
    "M7 7h10v10H7zM10 10h4v4h-4zM9 3v4m6-4v4M9 17v4m6-4v4M3 9h4m-4 6h4m10-6h4m-4 6h4",
  Culture: "M4 5h6v14H4zM14 5h6v14h-6zM2 22h20M7 2v3m10-3v3",
  Media: "M3 5h15v15H3zM18 9h3v11h-3M6 8h9M6 11h4v4H6zM13 11h2m-2 4h2M6 18h9",
  Campus: "m2 8 10-5 10 5-10 5L2 8Zm4 3v6q6 5 12 0v-6M22 8v9",
  Opinion: "M5 3h14v18H5zM8 7h8M8 11h8M8 15h5",
};
---

<svg
  class="topic-icon"
  width="24"
  height="24"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.4"
  stroke-linecap="square"
  stroke-linejoin="miter"
  aria-hidden="true"
>
  <path d={paths[topic] || paths.Opinion} />
</svg>
