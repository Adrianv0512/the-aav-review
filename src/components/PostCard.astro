---
import type { Post } from "../utils/posts";
import { readingTime, formatDate } from "../utils/posts";
import { url } from "../utils/urls";
import TopicIcon from "./TopicIcon.astro";
interface Props {
  post: Post;
  index?: number;
  headingLevel?: "h2" | "h3";
  lead?: boolean;
}
const { post, headingLevel: Heading = "h3", lead = false } = Astro.props;
const { data } = post;
---

<article
  class:list={["post-card", `accent-${data.accent}`, { "lead-story": lead }]}
>
  <a class="card-link" href={url(`writing/${post.id}/`)}>
    <div class="card-kicker">
      <span class="category-icon">
        <TopicIcon topic={data.tags[0]} />
      </span>
      <span>{data.tags[0]}</span>
      <span class="content-type">Opinion</span>
    </div>
    {data.illustration && (
      <img
        class="card-image"
        src={url(data.illustration)}
        width="640"
        height="360"
        alt=""
        aria-hidden="true"
        loading="lazy"
      />
    )}
    <Heading class="card-title">{data.title}</Heading>
    <p class="card-description">{data.description}</p>
    <div class="post-meta">
      <time datetime={data.publishedDate.toISOString()}>
        {formatDate(data.publishedDate)}
      </time>
      <span aria-hidden="true">/</span>
      <span>{readingTime(post.body)}</span>
    </div>
    <div class="card-bottom">
      <span>
        {data.demo ? "Sample essay" : `By ${data.author || "Adrian Vargas"}`}
      </span>
      <span class="read-article">
        Read article <span aria-hidden="true">→</span>
      </span>
    </div>
  </a>
</article>
