---
import { url } from "../utils/urls";
const path = Astro.url.pathname;
---

<header class="site-header wrap">
  <a class="wordmark" href={url()} aria-label="Adrian’s Notebook — home">
    <svg
      viewBox="0 0 36 40"
      width="29"
      height="34"
      fill="none"
      aria-hidden="true"
    >
      <rect
        x="6"
        y="3"
        width="25"
        height="33"
        rx="3"
        fill="#f5cb55"
        stroke="currentColor"
        stroke-width="2"
      />
      <path
        d="M12 3v33M3 10h6M3 19h6M3 28h6M17 12h9M17 18h7"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
      />
    </svg>
    <span>
      Adrian’s Notebook<span class="brand-dot">.</span>
    </span>
  </a>
  <nav aria-label="Main navigation">
    <a
      href={url("writing/")}
      aria-current={
        path.includes("/writing") || path.includes("/tags") ? "page" : undefined
      }
    >
      Writing
    </a>
    <a
      href={url("about/")}
      aria-current={path.includes("/about") ? "page" : undefined}
    >
      About
    </a>
    <a class="rss-nav" href={url("rss.xml")} aria-label="RSS feed">
      <svg
        width="19"
        height="19"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        aria-hidden="true"
      >
        <circle cx="5" cy="19" r="1" fill="currentColor" />
        <path d="M4 11a9 9 0 0 1 9 9M4 4a16 16 0 0 1 16 16" />
      </svg>
    </a>
  </nav>
</header>
