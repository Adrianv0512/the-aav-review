---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostCard from "../../components/PostCard.astro";
import TagPill from "../../components/TagPill.astro";
import { getPosts, allTags } from "../../utils/posts";
import { url } from "../../utils/urls";
const posts = await getPosts();
---

<BaseLayout
  title="Articles & analysis"
  description="Independent student commentary on politics, technology, and culture by Adrian Vargas."
>
  <div class="wrap">
    <header class="page-intro">
      <p class="eyebrow">The archive</p>
      <h1>
        Articles & analysis<span class="blue-dot">.</span>
      </h1>
      <p class="lead">
        Essays and commentary on current events.
        <br />
        Browse the full archive or select a subject.
      </p>
    </header>
    <nav class="archive-filters tag-list" aria-label="Filter writing by topic">
      <a class="tag-pill active" href={url("writing/")} aria-current="page">
        All subjects
      </a>
      {allTags(posts).map((tag) => (
        <TagPill tag={tag} />
      ))}
    </nav>
    <p class="entry-count">
      {posts.length} {posts.length === 1 ? "article" : "articles"} · Newest
      first
    </p>
    {posts.length ? (
      <div class="post-grid">
        {posts.map((post, index) => (
          <PostCard post={post} index={index} headingLevel="h2" />
        ))}
      </div>
    ) : (
      <p class="empty-state">
        Articles will appear here as they are published.
      </p>
    )}
  </div>
</BaseLayout>
<style>
  .blue-dot {
    color: var(--blue);
  }
</style>
