---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import TopicIcon from "../components/TopicIcon.astro";
import { getPosts, allTags } from "../utils/posts";
import { url, tagSlug } from "../utils/urls";
const posts = await getPosts();
const tags = allTags(posts);
---

<BaseLayout>
  <div class="wrap">
    <section class="publication-intro" aria-labelledby="publication-heading">
      <div>
        <p class="eyebrow">Independent student commentary</p>
        <h1 id="publication-heading">
          Current events.
          <br />
          <span>Considered perspectives.</span>
        </h1>
      </div>
      <div class="publication-deck">
        <p>
          Opinion and analysis on politics, technology, and culture. Written by
          Adrian Vargas.
        </p>
        <a class="text-link" href={url("about/")}>
          About the publication <span aria-hidden="true">→</span>
        </a>
      </div>
    </section>
    <div class="edition-line">
      <span>
        The AAV Review <span aria-hidden="true">/</span> Opinion &amp;
        analysis
      </span>
      <span>Est. 2026</span>
    </div>
    <section class="latest" aria-labelledby="latest-heading">
      <div class="section-heading">
        <h2 id="latest-heading">Latest commentary</h2>
        <a class="text-link" href={url("writing/")}>
          View archive <span aria-hidden="true">→</span>
        </a>
      </div>
      {posts.length ? (
        <div
          class:list={["front-page", { "single-story": posts.length === 1 }]}
        >
          {posts.slice(0, 3).map((post, index) => (
            <PostCard post={post} lead={index === 0} />
          ))}
        </div>
      ) : (
        <p class="empty-state">
          Articles will appear here as they are published.
        </p>
      )}
    </section>
    {tags.length > 0 && (
      <section class="sections" aria-labelledby="sections-heading">
        <div class="section-heading">
          <h2 id="sections-heading">Sections</h2>
          <span class="section-caption">Explore by subject</span>
        </div>
        <div class="section-grid">
          {tags.map((tag) => (
            <a href={url(`tags/${tagSlug(tag)}/`)}>
              <TopicIcon topic={tag} />
              <span>{tag}</span>
              <span class="section-arrow" aria-hidden="true">
                ↗
              </span>
            </a>
          ))}
        </div>
      </section>
    )}
    <section class="editorial-note">
      <div>
        <p class="eyebrow">The editorial approach</p>
        <h2>Evidence. Context. Perspective.</h2>
      </div>
      <div>
        <p>
          Clear arguments, direct sources, and a distinction between reporting
          and opinion. A student perspective on the decisions and developments
          shaping public life.
        </p>
        <a class="text-link" href={url("about/#editorial-standards")}>
          Editorial standards <span aria-hidden="true">→</span>
        </a>
      </div>
    </section>
  </div>
</BaseLayout>
<style>
  .publication-intro {
    display: grid;
    grid-template-columns: minmax(0, 2.1fr) minmax(0, 1fr);
    gap: 55px;
    align-items: end;
    padding: 55px 0 43px;
  }
  .publication-intro .eyebrow {
    margin-bottom: 22px;
  }
  .publication-intro h1 {
    font-size: clamp(2.8rem, 4.55vw, 4.25rem);
    line-height: 1.08;
    letter-spacing: -0.06em;
    font-weight: 650;
    margin: 0;
  }
  .publication-intro h1 span {
    color: var(--blue);
  }
  .publication-deck {
    border-left: 1px solid var(--line);
    padding-left: 30px;
  }
  .publication-deck p {
    font-family: var(--serif);
    font-size: 1rem;
    line-height: 1.85;
    margin-bottom: 12px;
  }
  .publication-deck .text-link {
    font-size: 0.82rem;
  }
  .edition-line {
    border-top: 2px solid var(--ink);
    border-bottom: 1px solid var(--line);
    padding: 11px 0;
    display: flex;
    justify-content: space-between;
    gap: 20px;
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.075em;
  }
  .edition-line > span:first-child {
    display: flex;
    gap: 16px;
  }
  .edition-line > span:last-child {
    color: var(--muted);
  }
  .latest {
    padding-top: 31px;
  }
  .latest .section-heading h2,
  .sections .section-heading h2 {
    font-size: 1.35rem;
    letter-spacing: -0.035em;
  }
  .front-page {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    column-gap: 36px;
    row-gap: 0;
  }
  .front-page :global(.lead-story) {
    grid-row: span 2;
    border-right: 1px solid var(--line);
    padding-right: 36px;
  }
  .front-page :global(.post-card:not(.lead-story)) {
    padding: 25px 0;
  }
  .front-page :global(.post-card:nth-child(2)) {
    padding-top: 0;
  }
  .front-page :global(.post-card:nth-child(3)) {
    border-top: 1px solid var(--line);
    padding-bottom: 0;
  }
  .front-page :global(.lead-story .card-title) {
    font-size: clamp(2rem, 3.1vw, 2.9rem);
    max-width: 550px;
    margin: 26px 0 20px;
    line-height: 1.12;
  }
  .front-page :global(.lead-story .card-description) {
    font-family: var(--serif);
    font-size: 1.08rem;
    line-height: 1.8;
    max-width: 520px;
    margin-bottom: 28px;
  }
  .front-page :global(.lead-story .card-kicker) {
    padding-top: 8px;
  }
  .front-page :global(.lead-story .category-icon) {
    width: 44px;
    height: 44px;
    background: var(--yellow-light);
  }
  .front-page :global(.post-card:not(.lead-story) .card-title) {
    font-size: 1.6rem;
    margin: 13px 0 10px;
  }
  .front-page :global(.post-card:not(.lead-story) .card-description) {
    margin-bottom: 14px;
  }
  .front-page :global(.post-card:not(.lead-story) .card-bottom) {
    padding-top: 14px;
  }
  .single-story {
    grid-template-columns: 1fr;
  }
  .single-story :global(.lead-story) {
    border-right: 0;
    padding-right: 0;
  }
  .sections {
    padding: 35px 0;
    margin-top: 40px;
    border-top: 2px solid var(--ink);
  }
  .section-caption {
    color: var(--muted);
    font-size: 0.8rem;
  }
  .section-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0 28px;
  }
  .section-grid a {
    display: flex;
    align-items: center;
    gap: 13px;
    padding: 18px 0;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
    font-size: 0.94rem;
  }
  .section-grid :global(.topic-icon) {
    color: var(--muted);
    width: 20px;
    height: 20px;
  }
  .section-arrow {
    margin-left: auto;
    color: var(--muted);
  }
  .section-grid a:hover {
    color: var(--blue);
  }
  .editorial-note {
    display: grid;
    grid-template-columns: 1fr 1.3fr;
    gap: 60px;
    background: var(--green-light);
    border-top: 2px solid var(--ink);
    padding: 31px 34px;
    margin-top: 5px;
  }
  .editorial-note .eyebrow {
    font-size: 0.7rem;
    margin-bottom: 12px;
  }
  .editorial-note h2 {
    font-size: 1.7rem;
    line-height: 1.25;
    margin: 0;
  }
  .editorial-note p:not(.eyebrow) {
    font-size: 0.94rem;
    line-height: 1.8;
    margin: 0;
  }
  .editorial-note .text-link {
    font-size: 0.8rem;
    margin-top: 7px;
  }
  @media (max-width: 900px) {
    .publication-intro {
      gap: 25px;
    }
    .publication-intro h1 {
      font-size: 2.8rem;
    }
    .publication-deck {
      padding-left: 22px;
    }
    .publication-deck p {
      font-size: 0.9rem;
    }
    .front-page {
      column-gap: 25px;
    }
    .front-page :global(.lead-story) {
      padding-right: 25px;
    }
    .editorial-note {
      gap: 25px;
    }
  }
  @media (max-width: 650px) {
    .publication-intro {
      grid-template-columns: 1fr;
      padding: 34px 0 27px;
      gap: 24px;
    }
    .publication-intro h1 {
      font-size: clamp(2.3rem, 9.2vw, 3.3rem);
    }
    .publication-intro .eyebrow {
      font-size: 0.68rem;
      margin-bottom: 18px;
    }
    .publication-deck {
      border: 0;
      padding: 0;
    }
    .publication-deck p {
      font-size: 1rem;
      margin: 0;
      max-width: 440px;
    }
    .edition-line {
      font-size: 0.62rem;
      gap: 10px;
    }
    .edition-line > span:first-child {
      gap: 9px;
    }
    .edition-line > span:last-child {
      display: none;
    }
    .front-page {
      grid-template-columns: 1fr;
    }
    .front-page :global(.lead-story) {
      border-right: 0;
      border-bottom: 1px solid var(--line);
      padding: 0 0 25px;
      margin-bottom: 25px;
      grid-row: auto;
    }
    .front-page :global(.lead-story .card-title) {
      font-size: 2rem;
      margin-top: 18px;
    }
    .front-page :global(.post-card:not(.lead-story) .card-title) {
      font-size: 1.65rem;
    }
    .front-page :global(.lead-story .card-description) {
      font-size: 1rem;
    }
    .section-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0 18px;
    }
    .section-grid a {
      gap: 8px;
      font-size: 0.82rem;
    }
    .section-grid :global(.topic-icon) {
      width: 18px;
      height: 18px;
      flex-shrink: 0;
    }
    .editorial-note {
      grid-template-columns: 1fr;
      padding: 25px 22px;
      gap: 18px;
    }
    .editorial-note h2 {
      font-size: 1.5rem;
    }
    .section-caption {
      font-size: 0.7rem;
    }
    .sections {
      margin-top: 30px;
      padding: 26px 0;
    }
    .latest {
      padding-top: 24px;
    }
  }
</style>
