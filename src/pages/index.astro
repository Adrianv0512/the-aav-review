---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import TagPill from "../components/TagPill.astro";
import Doodle from "../components/Doodle.astro";
import { getPosts, allTags } from "../utils/posts";
import { url } from "../utils/urls";
const posts = await getPosts();
const tags = allTags(posts);
---

<BaseLayout>
  <div class="wrap">
    <section class="hero" aria-labelledby="hero-heading">
      <div class="hero-copy">
        <p class="eyebrow">
          <span class="little-star" aria-hidden="true">
            ✳
          </span>{" "}
          A personal corner of the internet
        </p>
        <h1 id="hero-heading">
          A few thoughts.
          <br />A little{" "}
          <span class="curiosity">
            curiosity.
            <svg
              viewBox="0 0 420 20"
              preserveAspectRatio="none"
              aria-hidden="true"
            >
              <path
                d="M4 13Q175 0 414 9M25 19Q205 8 383 16"
                fill="none"
                stroke="currentColor"
                stroke-width="4"
                stroke-linecap="round"
              />
            </svg>
          </span>
        </h1>
        <p class="hero-description">
          Politics, technology, culture, and other
          <br class="desktop-break" /> things I’m thinking about.
        </p>
        <div class="hero-actions">
          <a class="button" href={url("writing/")}>
            Start reading <span aria-hidden="true">↗</span>
          </a>
          <span class="byline">A notebook by Adrian Vargas</span>
        </div>
      </div>
      <div class="hero-art">
        <Doodle name="hero-notebook" />
        <span class="hand-note">
          a work in progress,
          <br />
          just like my opinions.
        </span>
      </div>
    </section>
    <div class="editorial-rule">
      <span>Independent thoughts. Open tabs. Unfinished questions.</span>
      <span aria-hidden="true">
        EST. 2026 <span class="rule-star">✳</span>
      </span>
    </div>
    <section class="latest" aria-labelledby="latest-heading">
      <div class="section-heading">
        <h2 id="latest-heading">
          Fresh from the notebook<span class="heading-dot">.</span>
        </h2>
        <a class="text-link" href={url("writing/")}>
          All writing <span aria-hidden="true">↗</span>
        </a>
      </div>
      {posts.length ? (
        <div class="post-grid">
          {posts.slice(0, 3).map((post, index) => (
            <PostCard post={post} index={index} />
          ))}
        </div>
      ) : (
        <p class="empty-state">
          A fresh page. The first entry will be here soon.
        </p>
      )}
    </section>
    {tags.length > 0 && (
      <section class="topics" aria-labelledby="topics-heading">
        <div>
          <p class="eyebrow">Following my curiosity</p>
          <h2 id="topics-heading">
            Things I’m <br />
            thinking about
          </h2>
        </div>
        <div class="topic-links">
          {tags.map((tag) => (
            <TagPill tag={tag} />
          ))}
          <span class="topic-note">
            No particular order. Plenty of overlap.
          </span>
        </div>
        <span class="topic-spark" aria-hidden="true">
          ✳
        </span>
      </section>
    )}
    <section class="closing lined-note">
      <Doodle name="pencil" />
      <div>
        <h2>A notebook, not a newsfeed.</h2>
        <p>
          No hot-take quota. No endless scroll. Just a place to slow down,
          <br class="desktop-break" /> follow a thought, and see where it goes.
        </p>
        <a class="text-link" href={url("about/")}>
          A little more about me <span aria-hidden="true">↗</span>
        </a>
      </div>
      <span class="closing-star" aria-hidden="true">
        ✶
      </span>
    </section>
  </div>
</BaseLayout>
<style>
  .hero {
    display: grid;
    grid-template-columns: 1.35fr 1fr;
    align-items: center;
    gap: 25px;
    padding: 66px 0 56px;
  }
  .hero .eyebrow {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 26px;
    font-size: 0.7rem;
  }
  .little-star {
    font-size: 24px;
    color: var(--blue);
    line-height: 1;
  }
  .hero h1 {
    font-size: clamp(3.5rem, 5.9vw, 5.4rem);
    line-height: 1.055;
    font-weight: 650;
    letter-spacing: -0.065em;
    margin-bottom: 32px;
  }
  .curiosity {
    position: relative;
    color: var(--blue);
    white-space: nowrap;
  }
  .curiosity svg {
    position: absolute;
    left: 0;
    bottom: -13px;
    width: 100%;
    height: 16px;
    color: var(--blue);
  }
  .hero-description {
    font-size: 1.08rem;
    line-height: 1.75;
    color: var(--muted);
    margin-bottom: 27px;
  }
  .hero-actions {
    display: flex;
    align-items: center;
    gap: 20px;
  }
  .byline {
    font-size: 0.72rem;
    color: var(--muted);
  }
  .hero-art {
    position: relative;
    align-self: stretch;
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 0;
  }
  .hero-art :global(.doodle) {
    width: 100%;
    max-width: 430px;
    transform: rotate(-3deg);
  }
  .hand-note {
    position: absolute;
    right: 15px;
    bottom: -5px;
    font-family: var(--serif);
    font-size: 0.85rem;
    font-style: italic;
    line-height: 1.6;
    transform: rotate(-7deg);
    color: var(--muted);
  }
  .editorial-rule {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 15px;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    padding: 12px 0;
    font-size: 0.72rem;
    color: var(--muted);
  }
  .editorial-rule > span:last-child {
    display: flex;
    align-items: center;
    gap: 22px;
    font-size: 0.65rem;
    letter-spacing: 0.1em;
  }
  .rule-star {
    font-size: 22px;
    color: var(--ink);
  }
  .latest {
    padding-top: 47px;
  }
  .latest h2 {
    font-size: 1.95rem;
  }
  .heading-dot {
    color: var(--blue);
  }
  .topics {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1.45fr;
    gap: 50px;
    align-items: center;
    padding: 58px 0;
    border-bottom: 1px solid var(--line);
  }
  .topics .eyebrow {
    font-size: 0.68rem;
    margin-bottom: 12px;
  }
  .topics h2 {
    font-size: 2rem;
    margin: 0;
  }
  .topic-links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    padding-right: 50px;
  }
  .topic-links :global(.tag-pill):nth-child(3n + 1) {
    background: var(--blue-light);
  }
  .topic-links :global(.tag-pill):nth-child(3n + 2) {
    background: var(--yellow-light);
  }
  .topic-links :global(.tag-pill):nth-child(3n) {
    background: var(--red-light);
  }
  .topic-note {
    width: 100%;
    font-size: 0.74rem;
    color: var(--muted);
    margin-top: 4px;
  }
  .topic-spark {
    position: absolute;
    right: 0;
    top: 70px;
    font-size: 46px;
    transform: rotate(15deg);
    color: var(--green);
  }
  .closing {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 40px;
    padding: 37px;
    margin-top: 45px;
    border: 1px solid #c7cbb7;
    border-radius: 12px;
  }
  .closing :global(.doodle) {
    width: 105px;
    transform: rotate(-13deg);
  }
  .closing h2 {
    font-size: 1.7rem;
    margin-bottom: 14px;
  }
  .closing p {
    font-size: 0.9rem;
    color: #51594b;
    margin-bottom: 5px;
    line-height: 1.9;
  }
  .closing .text-link {
    font-size: 0.8rem;
  }
  .closing-star {
    font-size: 47px;
    color: var(--green);
    position: absolute;
    top: 13px;
    right: 28px;
  }
  @media (max-width: 1000px) {
    .hero-actions {
      flex-wrap: wrap;
      gap: 15px;
    }
    .hero h1 {
      font-size: clamp(3rem, 6vw, 5rem);
    }
    .hand-note {
      right: 0;
      bottom: 15px;
    }
    .topics {
      gap: 25px;
    }
    .hero {
      padding-top: 50px;
    }
  }
  @media (max-width: 650px) {
    .hero {
      grid-template-columns: 1fr;
      padding: 37px 0 25px;
      gap: 12px;
    }
    .hero .eyebrow {
      font-size: 0.59rem;
      letter-spacing: 0.1em;
      margin-bottom: 22px;
    }
    .hero h1 {
      font-size: clamp(2.8rem, 12vw, 4.5rem);
      margin-bottom: 28px;
    }
    .hero-description {
      font-size: 1rem;
      margin-bottom: 24px;
    }
    .hero-art {
      height: 240px;
      margin-top: 10px;
    }
    .hero-art :global(.doodle) {
      width: 275px;
      height: 250px;
    }
    .hand-note {
      bottom: 0;
      font-size: 0.72rem;
      right: 5px;
    }
    .byline {
      font-size: 0.7rem;
    }
    .hero-actions {
      gap: 15px;
    }
    .editorial-rule {
      font-size: 0.65rem;
      padding-block: 13px;
    }
    .editorial-rule > span:last-child {
      display: none;
    }
    .latest {
      padding-top: 35px;
    }
    .latest h2 {
      font-size: 1.55rem;
      max-width: 210px;
    }
    .topics {
      grid-template-columns: 1fr;
      gap: 24px;
      padding: 38px 0;
    }
    .topics h2 {
      font-size: 1.8rem;
    }
    .topics h2 br {
      display: none;
    }
    .topic-links {
      padding-right: 0;
    }
    .topic-spark {
      top: 22px;
      font-size: 35px;
    }
    .closing {
      padding: 30px 23px;
      gap: 12px;
      align-items: flex-start;
      margin-top: 30px;
    }
    .closing :global(.doodle) {
      display: none;
    }
    .closing h2 {
      font-size: 1.4rem;
      max-width: 230px;
    }
    .closing p {
      font-size: 0.85rem;
    }
    .closing-star {
      font-size: 29px;
      right: 14px;
      top: 10px;
    }
    .desktop-break {
      display: none;
    }
  }
</style>
