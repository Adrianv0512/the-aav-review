---
import BaseLayout from "../layouts/BaseLayout.astro";
import { url } from "../utils/urls";
---

<BaseLayout title="Page not found" noindex>
  <section class="wrap missing">
    <p class="eyebrow">Error 404</p>
    <h1>Page not found.</h1>
    <p>The requested page may have moved or is no longer available.</p>
    <a class="button" href={url("writing/")}>
      Browse the archive <span aria-hidden="true">→</span>
    </a>
  </section>
</BaseLayout>
<style>
  .missing {
    padding-block: 85px;
    min-height: 50vh;
  }
  .missing h1 {
    font-size: clamp(2.7rem, 5vw, 4.5rem);
    margin-bottom: 24px;
  }
  .missing > p:not(.eyebrow) {
    color: var(--muted);
    margin-bottom: 30px;
  }
</style>
