---
import BaseLayout from "../layouts/BaseLayout.astro";
import { settings } from "../settings";
import { url } from "../utils/urls";
---

<BaseLayout
  title="About"
  description="Independent student commentary by Adrian Vargas on politics, public policy, technology, and culture."
>
  <div class="wrap about-page">
    <header class="page-intro">
      <p class="eyebrow">About the publication</p>
      <h1>
        A student perspective
        <br />
        on public life.
      </h1>
      <p class="lead">
        Adrian’s Notebook is an independent publication by Adrian Vargas, a
        student writing about politics, public policy, technology, and culture.
      </p>
    </header>
    <div class="about-columns">
      <aside class="author-panel">
        <span class="author-monogram" aria-hidden="true">
          AV
        </span>
        <h2>Adrian Vargas</h2>
        <p>Student &amp; writer</p>
        <div class="author-subjects">
          <span>Politics &amp; public policy</span>
          <span>Technology &amp; society</span>
          <span>Culture &amp; media</span>
        </div>
        <a class="text-link" href={settings.github}>
          GitHub <span aria-hidden="true">↗</span>
        </a>
      </aside>
      <div class="about-copy">
        <h2>The purpose</h2>
        <p>
          This publication examines current events and the ideas behind them.
          Its focus is on how public decisions are made, how technology changes
          everyday life, and how culture shapes the way we understand both.
        </p>
        <p>
          The writing presents an individual student’s analysis and opinions.
          Arguments should stand on their evidence and reasoning, and readers
          should be able to examine the sources for themselves.
        </p>
        <h2 id="editorial-standards">Editorial standards</h2>
        <p>
          Factual claims should be supported by direct sources wherever
          possible. Analysis and opinion should be distinguishable from
          reporting. Quotations should be attributed, and uncertainty should be
          stated clearly.
        </p>
        <p>
          Material corrections should be acknowledged, with an updated date on
          the article. New evidence may change a conclusion; the reasoning for
          that change should be visible.
        </p>
        <a class="button" href={url("writing/")}>
          Read the articles <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
<style>
  .about-page {
    max-width: 1040px;
  }
  .page-intro {
    max-width: 860px;
    padding-bottom: 40px;
  }
  .page-intro h1 {
    font-size: clamp(2.5rem, 5vw, 4.4rem);
  }
  .about-columns {
    display: grid;
    grid-template-columns: 240px minmax(0, 1fr);
    gap: 65px;
    border-top: 2px solid var(--ink);
    padding-top: 38px;
  }
  .author-panel {
    border-right: 1px solid var(--line);
    padding-right: 30px;
  }
  .author-monogram {
    display: grid;
    place-items: center;
    background: var(--blue-light);
    border-top: 3px solid var(--blue);
    width: 88px;
    height: 88px;
    font-size: 2rem;
    font-weight: 600;
    letter-spacing: -0.07em;
    margin-bottom: 24px;
  }
  .author-panel h2 {
    font-size: 1.25rem;
    margin-bottom: 5px;
  }
  .author-panel > p {
    color: var(--muted);
    font-size: 0.85rem;
  }
  .author-subjects {
    display: grid;
    gap: 7px;
    font-size: 0.78rem;
    border-top: 1px solid var(--line);
    padding-top: 20px;
    margin-top: 22px;
  }
  .author-panel .text-link {
    font-size: 0.8rem;
    margin-top: 20px;
  }
  .about-copy {
    font-family: var(--serif);
    font-size: 1.03rem;
    line-height: 1.9;
  }
  .about-copy h2 {
    font-family: var(--sans);
    font-size: 1.7rem;
    margin-top: 30px;
    margin-bottom: 18px;
  }
  .about-copy h2:first-child {
    margin-top: 0;
  }
  .about-copy p {
    margin-bottom: 1.5em;
  }
  .about-copy .button {
    font-family: var(--sans);
    font-size: 0.9rem;
    margin-top: 12px;
  }
  @media (max-width: 650px) {
    .about-columns {
      grid-template-columns: 1fr;
      gap: 28px;
      padding-top: 25px;
    }
    .author-panel {
      border-right: 0;
      border-bottom: 1px solid var(--line);
      padding: 0 0 25px;
    }
    .author-monogram {
      width: 64px;
      height: 64px;
      font-size: 1.6rem;
    }
    .author-subjects {
      display: none;
    }
    .author-panel .text-link {
      margin-top: 0;
    }
    .about-copy {
      font-size: 1rem;
    }
  }
</style>
