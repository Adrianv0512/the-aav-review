---
import BaseLayout from "../layouts/BaseLayout.astro";
import Doodle from "../components/Doodle.astro";
import { settings } from "../settings";
import { url } from "../utils/urls";
---

<BaseLayout
  title="About"
  description="A little about Adrian and the notebook: a personal place for curiosity, writing, and thinking out loud."
>
  <div class="wrap about-page">
    <header class="about-heading">
      <div>
        <p class="eyebrow">The person behind the pages</p>
        <h1>
          Hi, I’m Adrian<span>.</span>
        </h1>
        <p class="intro">
          This is my little corner
          <br />
          of the internet.
        </p>
      </div>
      <div class="portrait lined-note">
        <Doodle name="notebook" />
        <span>Always another blank page.</span>
      </div>
    </header>
    <div class="about-copy">
      <aside class="demo-note">
        Starter biography — replace this introduction with your own words before
        sharing the site.
      </aside>
      <p>
        I’m interested in politics, public policy, technology, culture, and the
        things that don’t fit neatly into a category. This notebook is a place
        to give those interests a little room.
      </p>
      <p>
        Some entries will be questions. Others will be arguments, observations,
        or ideas I’m still working through. The thread connecting them is
        curiosity.
      </p>
      <h2>Why a notebook?</h2>
      <p>
        A notebook leaves room to change your mind. It doesn’t demand a reaction
        to everything. It’s somewhere to pay attention, put a thought into
        words, and come back to it later.
      </p>
      <p>
        This is a personal site. The writing reflects one person’s perspective,
        and the goal is to make the reasoning and sources clear enough for you
        to form your own.
      </p>
      <h2>Make yourself at home.</h2>
      <p>
        Pick an entry that catches your eye. Follow a source. Disagree with a
        conclusion. There’s no correct order to read a notebook.
      </p>
      <div class="about-actions">
        <a class="button" href={url("writing/")}>
          Explore the writing <span aria-hidden="true">↗</span>
        </a>
        <a class="text-link" href={settings.github}>
          Find me on GitHub ↗
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
<style>
  .about-page {
    max-width: 960px;
  }
  .about-heading {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    align-items: center;
    gap: 45px;
    padding: 70px 0 40px;
  }
  .about-heading h1 {
    font-size: clamp(2.8rem, 5vw, 4.5rem);
    margin-bottom: 25px;
  }
  .about-heading h1 span {
    color: var(--blue);
  }
  .intro {
    font-family: var(--serif);
    font-size: 1.3rem;
    line-height: 1.7;
    color: var(--muted);
  }
  .portrait {
    border: 1.5px solid var(--ink);
    border-radius: 16px;
    transform: rotate(4deg);
    padding: 20px;
    text-align: center;
  }
  .portrait :global(.doodle) {
    width: 230px;
    margin: auto;
  }
  .portrait span {
    font-size: 0.75rem;
  }
  .about-copy {
    max-width: 680px;
    margin: auto;
    font-family: var(--serif);
    line-height: 1.95;
    font-size: 1.05rem;
  }
  .about-copy p {
    margin-bottom: 1.8em;
  }
  .about-copy h2 {
    font-family: var(--sans);
    font-size: 1.8rem;
    margin-top: 1.8em;
  }
  .about-copy .demo-note {
    margin-bottom: 30px;
  }
  .about-actions {
    font-family: var(--sans);
    display: flex;
    gap: 25px;
    align-items: center;
    flex-wrap: wrap;
    margin-top: 30px;
  }
  @media (max-width: 650px) {
    .about-heading {
      grid-template-columns: 1fr;
      gap: 18px;
      padding-top: 40px;
    }
    .portrait {
      max-width: 260px;
      width: 100%;
      margin: 0 auto 15px;
    }
    .portrait :global(.doodle) {
      height: 180px;
    }
    .about-heading h1 {
      font-size: 2.65rem;
    }
    .intro {
      font-size: 1.1rem;
    }
    .about-copy {
      font-size: 1rem;
    }
  }
</style>
